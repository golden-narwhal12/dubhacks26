{
  "name": "trace-workbench",
  "productName": "Trace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/desktop.mjs",
