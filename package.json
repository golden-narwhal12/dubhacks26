{
  "name": "trace-workbench",
  "productName": "Trace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/desktop.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && vitest run",
    "setup:simavr": "node scripts/setup-simavr.mjs",
    "setup:libraries": "node scripts/setup-libraries.mjs",
    "test:toolchain": "TRACE_LIVE_TOOLCHAIN=1 vitest run tests/toolchain.test.ts",
    "format": "prettier --write src desktop scripts tests *.ts docs AGENTS.md README.md",
    "package": "npm run build && node scripts/package.mjs",
    "icon": "electron scripts/icon.cjs",
    "test:package": "TRACE_PACKAGED=1 playwright test tests/e2e/package.spec.ts",
    "evaluate:gemini": "node scripts/evaluate.mjs",
    "evaluate:fixtures": "playwright test tests/e2e/evaluation-fixtures.spec.ts tests/e2e/agent-runtime.spec.ts tests/e2e/agent-diagnostics.spec.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.12.0",
    "dockview-react": "^8.6.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "serialport": "^13.0.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.9.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
